# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:8080,http://localhost:5173
COOKIE_DOMAIN=localhost

# --- Mongo (use mongo:27017 instead of localhost when running via docker-compose) ---
MONGODB_URI=mongodb://localhost:27017/yakkyofy_demo

# --- RabbitMQ (use rabbitmq:5672 instead of localhost when running via docker-compose) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Auth (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_development_use_only
STRIPE_WEBHOOK_SECRET=whsec_xxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_for_development_use_only

# --- PayPal (sandbox app from https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=sandbox_client_id
PAYPAL_CLIENT_SECRET=sandbox_client_secret
PAYPAL_ENV=sandbox
VITE_PAYPAL_CLIENT_ID=sandbox_client_id

# --- Mangopay (sandbox app from https://dashboard.sandbox.mangopay.com) ---
MANGOPAY_CLIENT_ID=sandbox_client_id
MANGOPAY_API_KEY=sandbox_api_key
MANGOPAY_BASE_URL=https://api.sandbox.mangopay.com

# --- FX rates (optional; falls back to static table if unset) ---
FX_API_URL=https://open.er-api.com/v6/latest/EUR

# --- Frontend build-time API base ---
VITE_API_BASE_URL=http://localhost:4000/api
