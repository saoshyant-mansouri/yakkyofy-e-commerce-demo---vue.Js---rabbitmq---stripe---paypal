# Vercel runs its own `npm install` per vercel.json's installCommand — none
# of this needs to be uploaded, and infra/.terraform alone is >300MB (well
# over Vercel's 100MB deployment upload limit).
node_modules
apps/api/node_modules
apps/worker/node_modules
apps/web/node_modules
apps/web/dist
infra/.terraform
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/*.tfplan
.git
*.log
.DS_Store
# Local env files must never reach Vercel: Vite would bake their VITE_* values
# (e.g. VITE_API_BASE_URL=http://localhost:4000/api) into the production
# bundle, and they hold server secrets the static frontend never needs.
# Production values belong in the Vercel project's environment settings.
.env
.env.*
!.env.example
