# Terraform (infra/) — state and real secrets never get committed.
# infra/.terraform.lock.hcl is NOT ignored — Terraform's own guidance is to
# commit it, for reproducible provider version selection.
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/*.tfstate
infra/*.tfstate.backup
infra/terraform.tfvars
infra/*.tfplan
infra/tfplan
infra/tfplan.out
infra/*.tfplan.out

# Vercel — local project-link metadata created by `vercel link`/`vercel deploy`
.vercel
.env*
